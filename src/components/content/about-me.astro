<style>
    h2 {
        font-size: 1.85rem !important;
    }

    li {
        display: flex;
        gap: 0.1rem 0.5rem;
        margin-left: 0.25rem !important;
    }

    li::before {
        content: "•";
    }

    .accented {
        border-left: solid var(--primary-accent-dark) 3px;
        padding: 0.5rem 0.8rem;
        margin-left: 0.05rem;

        display: grid;
        grid-template-columns: 60px 1fr;
        gap: 0.5rem 1rem;
    }

    .accented-hero {
        display: flex;
        flex-direction: column;
    }

    .accented-content {
        grid-column: span 2;
    }

    .accented + .accented {
        margin-top: 0.25rem;
    }

    @media (max-width: 1000px) {
        .accented:has(img) {
            flex-direction: column;
        }
    }

    @media (min-width: 1300px) {
        #tech-marquee-container {
            margin: -1rem -3rem 0 -3rem;
        }

        #tech-list-container {
            margin-top: 0.5rem;
        }
    }
</style>
