---
import PictureFrame from "./picture-frame.astro";

import frameData from "../data/tech.js";

const sortableData = [];
for (let obj in frameData) sortableData.push(frameData[obj as keyof typeof frameData]);

const sortedData = sortableData.sort(() => Math.random() - 0.5);
---

<figure aria-label="Technology skills">
    <div>
        {
            sortedData.map((data) => (
                <PictureFrame data={data} />
            ))
        }
        {
            sortedData.map((data) => (
                <PictureFrame data={data} />
            ))
        }
    </div>
</figure>

<details>
    <summary>Full list</summary>
    <ul>
        {
            sortedData.map((data) => (
                <li>
                    <img src={data.src} alt={data.title} width="32" height="32" />
                    <p>{data.title}</p>
                </li>
            ))
        }
    </ul>
</details>

<style>
    figure {
        overflow: hidden;
        min-width: 100%;
        position: relative;
        margin: 2rem 0 1rem 0;
    }

    figure {
        scrollbar-width: none;
    }

    figure > div {
        width: max-content;
        display: flex;
        align-items: center;
        flex-direction: row;
        gap: 0.5rem;
        animation: marquee linear 35s infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        figure {
            overflow: scroll;
        }

        figure > div {
            animation: none;
        }
    }

    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }

    summary {
        cursor: pointer;
        margin-bottom: 1.5rem;
    }

    summary:hover {
        color: var(--primary-accent-dark);
    }

    ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }

    li {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
    }
</style>
