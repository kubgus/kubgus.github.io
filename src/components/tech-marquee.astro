---
import PictureFrame from "./picture-frame.astro";

import frameData from "../data/tech.js";

const sortableData = [];
for (let obj in frameData) sortableData.push(frameData[obj as keyof typeof frameData]);

const sortedData = sortableData.sort((a, b) => a.title.localeCompare(b.title));
---

<figure aria-hidden="true">
    <div id="reveal-gradient" />
    <div class="marquee-container">
        {
            sortedData.map((data) => (
                <PictureFrame data={data} />
            ))
        }
        {
            sortedData.map((data) => (
                <PictureFrame data={data} />
            ))
        }
    </div>
</figure>

<style>
    figure {
        overflow: hidden;
        min-width: 100%;
        position: relative;
        margin: 2rem 0 1rem 0;
    }

    figure {
        scrollbar-width: none;
    }

    .marquee-container {
        width: max-content;
        display: flex;
        align-items: center;
        flex-direction: row;
        gap: 0.5rem;
        animation: marquee linear 35s infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        figure {
            overflow: scroll;
        }

        .marquee-container {
            animation: none;
        }
    }

    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }

    #reveal-gradient {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, var(--background-dark) 0%, transparent 10%, transparent 90%, var(--background-dark) 100%);
        pointer-events: none;
        z-index: 1;
    }
</style>
