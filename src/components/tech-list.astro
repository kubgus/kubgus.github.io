---
import frameData from "../data/tech.js";

const sortableData = [];
for (let obj in frameData) sortableData.push(frameData[obj as keyof typeof frameData]);

const sortedData = sortableData.sort((a, b) => a.title.localeCompare(b.title));
---

<details>
    <summary>
        <span class="triangle"></span>
        <span class="summary-text">Full list</span>
    </summary>
    <ul>
        {
            sortedData.map((data) => (
                <li>
                    <img src={data.src} alt={data.title} width="32" height="32" />
                    <p>{data.title}</p>
                </li>
            ))
        }
    </ul>
</details>

<style>
    summary {
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: color 0.1s ease-in-out;
    }

    summary:hover {
        color: var(--primary-accent-dark);
    }

    summary:webkit-details-marker {
        display: none;
    }

    .summary-text {
        user-select: none;
        -webkit-user-select: none; /* Safari/Chrome */
        -moz-user-select: none;    /* Firefox */
        -ms-user-select: none;     /* IE/Edge */
    }

    .triangle {
        display: inline-block;
        transition: transform 0.2s ease;
        font-size: 1rem;
        transform: translateY(-1px);
    }

    .triangle::before {
        content: '>';
    }

    details[open] .triangle {
        transform: translateY(-1px) translateX(2px) rotate(90deg);
    }

    ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }

    li {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
    }
</style>
